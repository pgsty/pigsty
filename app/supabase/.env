############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############
# Demo API keys follow the official Docker generate-keys.sh signing logic:
# Public demo JWT_SECRET; HS256 keys, issuer "supabase", five-year expiry.
# Source: https://github.com/supabase/supabase/blob/self-hosted/v0.8.4/docker/utils/generate-keys.sh
# This demo set was issued at 2026-11-08T00:28:01Z and expires at 2031-11-07T00:28:01Z.
# Regenerate JWT_SECRET, ANON_KEY, and SERVICE_ROLE_KEY together before production use.
# https://supabase.com/docs/guides/self-hosting/docker#configuring-and-securing-supabase

POSTGRES_PASSWORD=DBUser.Supa       # supabase dbsu password (shared by multiple supabase biz users)
JWT_SECRET=pigsty-demo-jwt-secret-2026-11-08-change-before-production
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzk0MDk3NjgxLCJleHAiOjE5NTE3Nzc2ODF9.8-Y5zflO5LNwRP5qKm9Kgw2cMboaiTzWEeamQFSMHoM
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3OTQwOTc2ODEsImV4cCI6MTk1MTc3NzY4MX0.W3_AFd0Y2RrHEmAOezvuX6AeCqrfjpQonbYZ8plmAYE
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
REALTIME_DB_ENC_KEY=supabaserealtime
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

DASHBOARD_USERNAME=supabase         # change to your own username
DASHBOARD_PASSWORD=pigsty           # change to your own password


############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############
POSTGRES_HOST=10.10.10.10           # change to Pigsty managed PostgreSQL cluster/instance VIP/IP
POSTGRES_PORT=5432                  # you can use other service port such as 5433, 5436, 6432, etc...
POSTGRES_DB=postgres                # change to supabase database name, `supa` by default in pigsty
POSTGRES_DOMAIN=pg-meta             # in case you want to use domain name in database URL

############
# Domain
# YOU MUST CHANGE THESE WHEN ACCESS VIA DOMAIN NAME
############
# replace if you intend to use Studio outside of localhost
SUPABASE_PUBLIC_URL=http://supa.pigsty
API_EXTERNAL_URL=http://supa.pigsty/auth/v1
SITE_URL=http://supa.pigsty


############
# API gateway - Envoy is the default in self-hosted/v0.8.4.
############
# Leave empty to honor an existing KONG_HTTP_PORT override; both default to 8000.
API_GW_HTTP_PORT=
# Optional Kong fallback settings for docker-compose.kong.yml.
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# API - Configuration for PostgREST.
############
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true


############
# Studio - Configuration for the Dashboard
############

STUDIO_PORT=3000
STUDIO_DEFAULT_PROJECT=Pigsty
STUDIO_DEFAULT_ORGANIZATION=Pigsty

# Enable webp support
IMGPROXY_ENABLE_WEBP_DETECTION=true
IMGPROXY_AUTO_WEBP=true

# Add your OpenAI API key to enable SQL Editor Assistant
OPENAI_API_KEY=

############
# Storage - Use external s3 or minio
############
S3_BUCKET=supa
GLOBAL_S3_BUCKET=supa
S3_ENDPOINT=https://sss.pigsty:9000
S3_ACCESS_KEY=supabase
S3_SECRET_KEY=S3User.Supabase
S3_FORCE_PATH_STYLE=true
S3_PROTOCOL=https
S3_REGION=stub
REGION=stub
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=supabase
S3_PROTOCOL_ACCESS_KEY_SECRET=S3User.Supabase
MINIO_DOMAIN_IP=10.10.10.10

############
# Functions - Configuration for Functions
############
# NOTE: VERIFY_JWT applies to all functions. Per-function VERIFY_JWT is not supported yet.
FUNCTIONS_VERIFY_JWT=false

# Total Functions container memory limit, shared by all workers.
FUNCTIONS_MEMORY_LIMIT=2g

############
# Logs - Configuration for Analytics
# Please refer to https://supabase.com/docs/reference/self-hosting-analytics/introduction
############

# use 32~64 character long random string for each key, the keys must be different
LOGFLARE_PUBLIC_ACCESS_TOKEN=1234567890abcdef1234567890abcdef
LOGFLARE_PRIVATE_ACCESS_TOKEN=fedcba0987654321fedcba0987654321
LOGFLARE_LOG_LEVEL=error
LOGFLARE_DB=_supabase
LOGFLARE_SCHEMA=_analytics

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
