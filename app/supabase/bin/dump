#!/usr/bin/env bash
set -euo pipefail
#==============================================================#
# File      :   app/supabase/bin/dump
# Desc      :   Dump Supabase Docker images to local dir
# Ctime     :   2025-07-01
# Mtime     :   2026-11-06
# Args      :   [directory] (default: /tmp/docker/supabase/)
# Usage     :   bin/dump [/tmp/docker/supabase/]
# License   :   Apache-2.0 @ https://pigsty.io/docs/about/license/
#==============================================================#

IMG_DIR=${1:-/tmp/docker/supabase}
mkdir -p "${IMG_DIR}"
echo "Dumping Supabase Docker images to: $IMG_DIR"

images=(
  "supabase/storage-api:v1.89.12 storage.tgz"
  "darthsim/imgproxy:v4.0.21 imgproxy.tgz"
  "supabase/studio:2026.11.02-sha-a05e7ec studio.tgz"
  "supabase/realtime:v2.148.3 realtime.tgz"
  "supabase/edge-runtime:v1.77.9 edge.tgz"
  "supabase/gotrue:v2.197.0 gotrue.tgz"
  "supabase/postgres-meta:v0.100.0 postgres.tgz"
  "supabase/logflare:1.50.15 logflare.tgz"
  "postgrest/postgrest:v14.18 postgrest.tgz"
  "timberio/vector:0.53.0-alpine vector.tgz"
  "envoyproxy/envoy:v1.39.6 envoy.tgz"
  "kong/kong:3.9.3 kong.tgz"
)

# The offline bundle deliberately includes both supported gateways, regardless
# of COMPOSE_FILE. Check the entire set before writing any image archives.
missing_image=0
for item in "${images[@]}"; do
  image=${item% *}
  if ! docker image inspect "${image}" >/dev/null 2>&1; then
    echo "Missing required image: ${image}" >&2
    missing_image=1
  fi
done
if [[ "${missing_image}" -ne 0 ]]; then
  echo "Run 'make pull' first; the full offline bundle needs Envoy and Kong." >&2
  exit 1
fi

# Save sequentially to limit memory and disk pressure. Preserve image metadata
# for every service; rootfs export/import loses the original image configuration.
for item in "${images[@]}"; do
  image=${item% *}
  archive=${item#* }
  docker save "${image}" | gzip -c -9 > "${IMG_DIR}/${archive}"
done

echo "All Supabase Docker images dump successfully!"
ls -alh "${IMG_DIR}"/*.tgz
