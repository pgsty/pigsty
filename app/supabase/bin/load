#!/usr/bin/env bash
set -euo pipefail
#==============================================================#
# File      :   app/supabase/bin/load
# Desc      :   Load Supabase Docker images from local
# Ctime     :   2025-07-01
# Mtime     :   2026-08-27
# Args      :   [directory] - directory containing tgz files (default: /tmp/docker/supabase/)
# Usage     :   bin/load [/tmp/docker/supabase/]
# License   :   Apache-2.0 @ https://pigsty.io/docs/about/license/
#==============================================================#

IMG_DIR=${1:-/tmp/docker/supabase}

echo "Loading Supabase Docker images from: $IMG_DIR"
echo "Starting image loading..."

archives=(
  storage.tgz
  imgproxy.tgz
  studio.tgz
  realtime.tgz
  edge.tgz
  gotrue.tgz
  postgres.tgz
  logflare.tgz
  postgrest.tgz
  vector.tgz
  envoy.tgz
  kong.tgz
)

# Reject incomplete bundles before importing any images.
for archive in "${archives[@]}"; do
  if [[ ! -s "${IMG_DIR}/${archive}" ]]; then
    echo "Missing or empty archive: ${IMG_DIR}/${archive}" >&2
    echo "Regenerate the complete bundle with 'make pull && make save'." >&2
    exit 1
  fi
done

# Load complete local archives sequentially. Docker detects gzip automatically.
for archive in "${archives[@]}"; do
  docker load --input "${IMG_DIR}/${archive}"
done

echo "All Supabase Docker images loaded successfully!"
