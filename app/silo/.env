# Silo is Pigsty's S3-compatible object storage fork.
SILO_IMAGE=docker.io/pgsty/silo:latest
SILO_ROOT_USER=siloadmin
SILO_ROOT_PASSWORD=S3User.Silo
SILO_PORT=9000
SILO_CONSOLE_PORT=9001
# Optional external console URL, including a non-default published port or proxy.
# Example: http://silo.example.com:19001
SILO_BROWSER_REDIRECT_URL=
SILO_DATA=/data/silo
