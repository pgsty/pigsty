################################# Image Configuration #################################
IMAGE_PULL_PREFIX=registry.cn-beijing.aliyuncs.com/jumpservice
JUMPSERVER_VERSION=v5.1.1-ce
REDIS_VERSION=7.4.12-bookworm

############################## Installation Configuration #############################
JUMPSERVER_DATA=/data/jumpserver
VOLUME_DIR=/data/jumpserver
DOCKER_SUBNET=192.168.250.0/24
REDIS_IP=192.168.250.2
CELERY_IP=192.168.250.3
CORE_IP=192.168.250.4
KAEL_IP=192.168.250.5
CHEN_IP=192.168.250.6
KOKO_IP=192.168.250.7
WEB_IP=192.168.250.8
INIT_IP=192.168.250.9

# Generate once and never change after production data exists:
#   openssl rand -base64 36 | tr -dc A-Za-z0-9 | head -c 48; echo
SECRET_KEY=ChangeMeSecretKeyMustBeKeptForever0123456789ABCDEF

# Generate once and never change after production data exists:
#   openssl rand -base64 24 | tr -dc A-Za-z0-9 | head -c 24; echo
BOOTSTRAP_TOKEN=ChangeMeBootstrapToken2026

LOG_LEVEL=ERROR
TZ=Asia/Shanghai
CURRENT_VERSION=v5.1.1-ce
CORE_WORKER=2
CELERY_WORKER_COUNT=2
# Run Ansible inside Celery, using the existing bind-mounted data layout.
# Docker isolation requires host Docker control and /opt/jumpserver/data paths.
ANSIBLE_DOCKER_ENABLED=false

################################# DB Configuration ####################################
# Do not use 127.0.0.1 here. Use the host intranet IP or Pigsty L2 VIP.
# DB_PASSWORD must not contain single quotes or double quotes.
DB_ENGINE=postgresql
DB_HOST=10.10.10.10
DB_PORT=5432
DB_USER=jumpserver
DB_PASSWORD=DBUser.JumpServer
DB_NAME=jumpserver

################################# Redis Configuration #################################
# Local Redis container in this compose stack.
# Use a fixed bridge IP to avoid Docker DNS resolution races in JumpServer workers.
# REDIS_PASSWORD must not contain single quotes or double quotes.
REDIS_HOST=192.168.250.2
REDIS_PORT=6379
REDIS_PASSWORD=Redis.JumpServer

################################# Access Configuration ################################
HTTP_PORT=8080
SSH_PORT=2222
KOKO_WEB_PROXY_PORT=5001
KOKO_PRIVILEGED=true
# Allow Website asset target hosts; retain loopback hosts for KoKo's control API.
WEB_PROXY_ALLOWED_HOSTS=localhost,127.0.0.1
CLIENT_MAX_BODY_SIZE=4096m
CORE_HOST=http://192.168.250.4:8080
PERIOD_TASK_ENABLED=true
SESSION_EXPIRE_AT_BROWSER_CLOSE=false
DOMAINS=10.10.10.10:8080,10.10.10.10,jump.pigsty
# Browser Origins allowed on Core WebSockets (5.1+); keep in sync with DOMAINS.
# Without it, scheme-less DOMAINS only allow HTTPS Origins. Never leave it empty.
WS_ALLOWED_ORIGINS=http://10.10.10.10:8080,http://10.10.10.10,http://jump.pigsty,https://jump.pigsty
USE_LB=1
USE_IPV6=0
USE_XPACK=0
JUMPSERVER_ENABLE_FONT_SMOOTHING=true

################################# Component Switches ##################################
CORE_ENABLED=1
CELERY_ENABLED=1
KOKO_ENABLED=1
KAEL_ENABLED=1
CHEN_ENABLED=1
WEB_ENABLED=1
