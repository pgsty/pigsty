# Pigsty Discourse: one application container with one embedded Redis instance.
DISCOURSE_DATA=/data/app/discourse
DISCOURSE_IMAGE=local_discourse/discourse:latest
# Freeze the classic Launcher and templates together. Review before updating.
DISCOURSE_DOCKER_REF=945d491ee62ac0d6e5d9076c173073c3f795d978
DISCOURSE_VERSION=tests-passed
DISCOURSE_HOSTNAME=ask.pigsty
DISCOURSE_FORCE_HTTPS=false
DISCOURSE_DEFAULT_LOCALE=en
DISCOURSE_DEVELOPER_EMAILS=admin@example.com

# External Pigsty PostgreSQL. Use a writable server, never transaction pooling.
PG_HOST=10.10.10.10
PG_PORT=5432
PG_DBNAME=discourse
PG_USERNAME=discourse
PG_PASSWORD=DBUser.Discourse

# Start small; DB_POOL is per process, not the whole application.
UNICORN_WORKERS=2
UNICORN_SIDEKIQS=1
DISCOURSE_SIDEKIQ_WORKERS=5
DISCOURSE_DB_POOL=8
REDIS_MAX_MEMORY=512mb

# Required for registration, password reset and notifications. CHANGE ME.
DISCOURSE_SMTP_ADDRESS=smtp.example.com
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=
DISCOURSE_SMTP_PASSWORD=
DISCOURSE_SMTP_ENABLE_START_TLS=true
DISCOURSE_SMTP_FORCE_TLS=false
DISCOURSE_SMTP_OPENSSL_VERIFY_MODE=peer
DISCOURSE_NOTIFICATION_EMAIL=noreply@example.com
# Only set to 1 for an isolated smoke test without real mail delivery.
DISCOURSE_SKIP_EMAIL_SETUP=0

# Optional CDN. Local uploads are the default; S3 is configured separately.
DISCOURSE_CDN_URL=
