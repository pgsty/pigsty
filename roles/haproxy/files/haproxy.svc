[Unit]
Description=HAProxy Load Balancer
Documentation=man:haproxy(1)
After=network.target

[Service]
LimitNOFILE=4194304
LimitNPROC=infinity
LimitCORE=infinity
Environment="EXTRAOPTS=-S /run/haproxy-master.sock"
EnvironmentFile=-/etc/default/haproxy
ExecStartPre=/usr/sbin/haproxy -Ws -f /etc/haproxy/haproxy.cfg -f /etc/haproxy/conf.d -c -q $EXTRAOPTS
ExecStart=/usr/sbin/haproxy -Ws -f /etc/haproxy/haproxy.cfg -f /etc/haproxy/conf.d $EXTRAOPTS
ExecReload=/usr/sbin/haproxy -Ws -f /etc/haproxy/haproxy.cfg -f /etc/haproxy/conf.d -c -q $EXTRAOPTS
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
SuccessExitStatus=143
Type=notify

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
