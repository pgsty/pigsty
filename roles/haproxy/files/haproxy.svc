[Unit]
Description=HAProxy2 Load Balancer
Documentation=https://www.haproxy.org/download/2.0/doc/configuration.txt
After=network.target

[Service]
LimitNOFILE=4194304
LimitNPROC=infinity
LimitCORE=infinity
Environment="CONFIG=/etc/haproxy/haproxy.cfg"
Environment="CFGDIR=/etc/haproxy/conf.d"
EnvironmentFile=-/etc/default/haproxy
ExecStartPre=/usr/sbin/haproxy -f $CONFIG -f $CFGDIR -c -q
ExecStart=/usr/sbin/haproxy -Ws -f $CONFIG -f $CFGDIR $OPTIONS
ExecReload=/usr/sbin/haproxy -f $CONFIG -f $CFGDIR -c -q
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
Type=notify

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
