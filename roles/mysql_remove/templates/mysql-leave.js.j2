// Managed by Pigsty: detach one member from the InnoDB Cluster through a survivor.
shell.options.useWizards = false;

const password = os.loadTextFile("/etc/mysql/pigsty/cluster-password").replace(/[\r\n]+$/, "");
function conn(host) {
  return {scheme: "mysql", user: "dbuser_cluster", password: password, host: host, port: 3306,
    "ssl-mode": "VERIFY_CA", "ssl-ca": "/etc/pki/ca.crt"};
}
const target = {{ inventory_hostname | to_json }};
const key = target + ":3306";

let cluster = null;
let survivor = null;
for (const host of {{ mysql_rm_survivors | to_json }}) {
  try {
    shell.setSession(mysql.getSession(conn(host)));
    cluster = dba.getCluster({{ mysql_cluster | to_json }});
    survivor = host;
    break;
  } catch (ignored) {}
}
if (!cluster) { throw new Error("no surviving member holds the cluster"); }

const member = cluster.status({extended: 1}).defaultReplicaSet.topology[key];
if (member) {
  const online = member.status === "ONLINE";
  // a leaving PRIMARY hands over first, so removal is never an unplanned failover
  if (online && member.memberRole === "PRIMARY") { cluster.setPrimaryInstance(survivor + ":3306"); }
  // an ONLINE member syncs and leaves; anything else is only dropped from the metadata
  cluster.removeInstance(conn(target), {force: !online});
}
print(JSON.stringify({pigstyChanged: Boolean(member), instance: key}));
