RUSTFS_VOLUMES="{{ minio_volumes }}"
RUSTFS_ADDRESS=":{{ minio_port }}"
RUSTFS_CONSOLE_ADDRESS=":{{ minio_admin_port }}"
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_ACCESS_KEY="{{ minio_access_key }}"
RUSTFS_SECRET_KEY="{{ minio_secret_key }}"
{% if minio_https|bool %}
RUSTFS_TLS_PATH="/home/{{ minio_user }}/.rustfs/certs"
RUSTFS_TRUST_SYSTEM_CA=1
{% endif %}
RUST_LOG={{ rustfs_log_level | default('warn') }}

# RustFS sends native OTLP/HTTP metrics directly to VictoriaMetrics. An explicit
# endpoint wins; otherwise use the first host in the infra inventory group. The signal-specific
# endpoint avoids accidentally sending traces or logs to the metrics database.
{% set rustfs_metrics_target = rustfs_metrics_endpoint|default('') %}
{% if rustfs_metrics_target == '' %}
{% set rustfs_metrics_host = groups.get('infra', []) | first | default('') %}
{% if rustfs_metrics_host != '' %}
{% set rustfs_metrics_target = 'http://' ~ rustfs_metrics_host ~ ':' ~ (hostvars[rustfs_metrics_host]['vmetrics_port'] | default(8428)) ~ '/opentelemetry/v1/metrics' %}
{% endif %}
{% endif %}
{% if rustfs_metrics_enabled|default(true)|bool and rustfs_metrics_target != '' %}
{% set rustfs_obs_root = rustfs_metrics_target | regex_replace('\?.*$', '') | regex_replace('/(?:opentelemetry/)?v1/metrics$', '') %}
# beta11 derives stdout fallback from the root endpoint only. Keep a non-empty
# root alongside the signal-specific endpoint so RUSTFS_OBS_USE_STDOUT=false is
# honored instead of printing every metric batch to stdout.
RUSTFS_OBS_ENDPOINT="{{ rustfs_obs_root }}"
RUSTFS_OBS_USE_STDOUT=false
RUSTFS_OBS_METRIC_ENDPOINT="{{ rustfs_metrics_target }}{% if '?' in rustfs_metrics_target %}&{% else %}?{% endif %}extra_label=job=minio&extra_label=flavor=rustfs&extra_label=cls={{ minio_cluster }}&extra_label=ins={{ minio_cluster }}-{{ minio_seq }}&extra_label=ip={{ inventory_hostname }}&extra_label=instance={{ inventory_hostname }}:{{ minio_port }}"
RUSTFS_OBS_METRICS_EXPORT_ENABLED=true
RUSTFS_OBS_METER_INTERVAL={{ rustfs_metrics_interval|default(15) }}
{% else %}
RUSTFS_OBS_METRICS_EXPORT_ENABLED=false
{% endif %}
RUSTFS_OBS_SERVICE_NAME=rustfs
RUSTFS_OBS_ENVIRONMENT={{ rustfs_metrics_environment|default('production') }}
RUSTFS_OBS_TRACES_EXPORT_ENABLED=false
RUSTFS_OBS_PROFILING_EXPORT_ENABLED=false

# RustFS logs go to journald through stdout. Pigsty's existing generic syslog
# collector can pick them up without adding any RustFS-specific Vector config.
{% if rustfs_log_enabled|default(true)|bool %}
RUSTFS_OBS_LOGGER_LEVEL={{ rustfs_log_level | default('warn') }}
RUSTFS_OBS_LOG_STDOUT_ENABLED=true
{% else %}
RUSTFS_OBS_LOG_STDOUT_ENABLED=false
{% endif %}
RUSTFS_OBS_LOGS_EXPORT_ENABLED=false

# ENVIRONMENT from minio_extra_vars (use RUSTFS_* names in RustFS mode)
{{ minio_extra_vars }}
