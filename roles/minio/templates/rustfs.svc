[Unit]
Description=RustFS Object Storage Server
Documentation=https://docs.rustfs.com
Wants=network-online.target
After=network-online.target
AssertFileIsExecutable=/usr/bin/rustfs

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=/usr/bin
User={{ minio_user }}
Group=minio
EnvironmentFile=-/etc/default/rustfs
ExecStart=/usr/bin/rustfs server $RUSTFS_VOLUMES
Restart=always
RestartSec=10s
LimitNOFILE=8388608
TasksMax=infinity
TimeoutStartSec=300s
TimeoutStopSec=120s
SendSIGKILL=no
# RustFS emits structured application logs to journald. Pigsty's existing
# generic syslog collector may consume them without a service-specific config.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
