# Managed by Pigsty. Readable only by root and prometheus.
[client]
user={{ mysql_monitor_username }}
# go-ini uses raw triple quotes; the exporter expands $$ to a literal $.
password="""{{ mysql_monitor_password | string | replace('$', '$$') }}"""
host=127.0.0.1
port=3306
ssl-ca={{ mysql_tls_ca }}
