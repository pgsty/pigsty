[Unit]
Description=JuiceFS {{ juice_name }}
After=network-online.target patroni.service postgres.service silo.service minio.service
Before=code-server.service jupyter.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/{{ juice_unit }}
ExecStart=/usr/bin/juicefs mount{% if juice_mount_opts | trim | length > 0 %} {{ juice_mount_opts | replace('%', '%%') | replace('$', '$$') }}{% endif %} --cache-dir "{{ juice_cache | regex_replace('/+', '/') | regex_replace('^(.+)/$', '\\1') | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') | replace('$', '$$') }}" --metrics 0.0.0.0:{{ juice_port }} ${JUICE_META} "{{ juice_path | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') | replace('$', '$$') }}"
ExecStop=/usr/bin/juicefs umount "{{ juice_path | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') | replace('$', '$$') }}"
Restart=on-failure
RestartSec=5
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
