#!/bin/bash
set -euo pipefail
#==============================================================#
# File      :   boot-pkg
# Desc      :   boot pigsty building environment with offline pkg
# Ctime     :   2023-10-15
# Mtime     :   2026-08-13
# Path      :   bin/boot-pkg
# License   :   Apache-2.0 @ https://pigsty.io/docs/about/license/
# Copyright :   2018-2026  Ruohang Feng / Vonng (rh@vonng.com)
#==============================================================#
PROG_NAME="$(basename $0)"
PROG_DIR="$(cd $(dirname $0) && pwd)"
VERSION=${1-'v4.6.0'}
ARCH=${2-'x86_64'}

#--------------------------------------------------------------#
# Usage
#--------------------------------------------------------------#
# bin/boot-pkg [version] [arch]
# arch: x86_64 (default) or aarch64

#--------------------------------------------------------------#
# Utils
#--------------------------------------------------------------#
__CN='\033[0m';__CK='\033[0;30m';__CR='\033[0;31m';__CG='\033[0;32m';
__CY='\033[0;33m';__CB='\033[0;34m';__CM='\033[0;35m';__CC='\033[0;36m';__CW='\033[0;37m';
function log_info() {  printf "[${__CG} OK ${__CN}] ${__CG}$*${__CN}\n";   }
function log_warn() {  printf "[${__CY}WARN${__CN}] ${__CY}$*${__CN}\n";   }
function log_error() { printf "[${__CR}FAIL${__CN}] ${__CR}$*${__CN}\n";   }
function log_debug() { printf "[${__CB}HINT${__CN}] ${__CB}$*${__CN}\n";   }
function log_input() { printf "[${__CM} IN ${__CN}] ${__CM}$*\n=> ${__CN}"; }
function log_hint()  { printf "${__CB}$*${__CN}\n"; }

BUILD_HOSTS=(el9 el10 d12 d13 u22 u24 u26)
BUILD_IPS=(10.10.10.9 10.10.10.10 10.10.10.12 10.10.10.13 10.10.10.22 10.10.10.24 10.10.10.26)
JOB_PIDS=()
JOB_HOSTS=()

function start_ssh() {
    local host="$1"
    shift
    ssh -nT -oBatchMode=yes "${host}" "$@" &
    JOB_PIDS+=("$!")
    JOB_HOSTS+=("${host}")
}

function start_scp() {
    local host="$1"
    local source="$2"
    local target="$3"
    scp -B "${source}" "${host}:${target}" &
    JOB_PIDS+=("$!")
    JOB_HOSTS+=("${host}")
}

function wait_jobs() {
    local stage="$1"
    local i status failed=0
    for i in "${!JOB_PIDS[@]}"; do
        if wait "${JOB_PIDS[$i]}"; then
            log_debug "${stage}: ${JOB_HOSTS[$i]} complete"
        else
            status=$?
            log_error "${stage}: ${JOB_HOSTS[$i]} failed (exit ${status})"
            failed=1
        fi
    done
    JOB_PIDS=()
    JOB_HOSTS=()
    return "${failed}"
}

log_info "copy source packages to building VMs"
for host in "${BUILD_HOSTS[@]}"; do
    start_scp "${host}" "dist/${VERSION}/pigsty-${VERSION}.tgz" "~/pigsty.tgz"
done
wait_jobs "copy source packages"

log_info "copy offline packages to building VMs (${ARCH})"
for i in "${!BUILD_HOSTS[@]}"; do
    start_scp "${BUILD_HOSTS[$i]}" "dist/${VERSION}/pigsty-pkg-${VERSION}.${BUILD_HOSTS[$i]}.${ARCH}.tgz" /var/tmp/pkg.tgz
done
wait_jobs "copy offline packages"

log_info "extract /var/tmp/pkg.tgz tarball"
for host in "${BUILD_HOSTS[@]}"; do
    start_ssh "${host}" 'sudo mkdir -p /www && sudo rm -rf /www/pigsty && sudo tar -xf /var/tmp/pkg.tgz -C /www'
done
wait_jobs "extract offline packages"

log_info "configure building environment"
for i in "${!BUILD_HOSTS[@]}"; do
    start_ssh "${BUILD_HOSTS[$i]}" "rm -rf ~/pigsty && tar -xf pigsty.tgz && cd ~/pigsty && ./configure -s -i ${BUILD_IPS[$i]}"
done
wait_jobs "configure building environment"

log_info "bootstrap building environment"
for host in "${BUILD_HOSTS[@]}"; do
    start_ssh "${host}" 'cd ~/pigsty && ./bootstrap'
done
wait_jobs "bootstrap building environment"


#log_info "building bootstrap complete"
#log_info "extracted, now proceed with:"
#log_hint "./deploy.yml -i conf/build/oss.yml"
